import ZilLib.TransitionSystem

/-!
# SMT-LIB 2 Text Generator for Transition Systems (TS-03)

This module produces SMT-LIB 2 standard text from a `TSModule` AST for:
1. Bounded Model Checking (BMC) up to depth $k$ using `push`/`pop` scopes.
2. $k$-Induction (Base case and Inductive step queries).

Zero Python, zero PySMT, zero external library bindings: pure Lean 4 emitting standard SMT-LIB 2.
-/

namespace ZilLib.SMT

open ZilLib.TransitionSystem

/-- Encode an aligned state variable name at an unrolled time step. -/
def varName (v : String) (step : Nat) : String :=
  s!"|v_{v}_{step}|"

/-- Convert a `TSSort` to SMT-LIB 2 sort name. -/
def toSmtSort : TSSort → String
  | .bool => "Bool"
  | .int => "Int"
  | .enumSort sn _ => sn

/-- Declare a custom datatype for enum sorts if needed. -/
def declareSort : TSSort → Option String
  | .enumSort sn elems =>
      let constructors := elems.map (fun e => s!"({sn}_{e})")
      some s!"(declare-datatypes (({sn} 0)) (({" ".intercalate constructors})))"
  | _ => none

/-- Translate a `TSExpr` into an SMT-LIB 2 S-expression at step `step`.
    Primed variables (`isPrimed == true`) refer to `step + 1`. -/
def toSmtExpr (step : Nat) : TSExpr → String
  | .constBool true => "true"
  | .constBool false => "false"
  | .constInt i => if i < 0 then s!"(- {(-i)})" else s!"{i}"
  | .constEnum sn v => s!"{sn}_{v}"
  | .var name false => varName name step
  | .var name true => varName name (step + 1)
  | .not e => s!"(not {toSmtExpr step e})"
  | .and e1 e2 => s!"(and {toSmtExpr step e1} {toSmtExpr step e2})"
  | .or e1 e2 => s!"(or {toSmtExpr step e1} {toSmtExpr step e2})"
  | .implies e1 e2 => s!"(=> {toSmtExpr step e1} {toSmtExpr step e2})"
  | .eq e1 e2 => s!"(= {toSmtExpr step e1} {toSmtExpr step e2})"
  | .neq e1 e2 => s!"(distinct {toSmtExpr step e1} {toSmtExpr step e2})"
  | .lt e1 e2 => s!"(< {toSmtExpr step e1} {toSmtExpr step e2})"
  | .le e1 e2 => s!"(<= {toSmtExpr step e1} {toSmtExpr step e2})"
  | .gt e1 e2 => s!"(> {toSmtExpr step e1} {toSmtExpr step e2})"
  | .ge e1 e2 => s!"(>= {toSmtExpr step e1} {toSmtExpr step e2})"
  | .add e1 e2 => s!"(+ {toSmtExpr step e1} {toSmtExpr step e2})"
  | .sub e1 e2 => s!"(- {toSmtExpr step e1} {toSmtExpr step e2})"
  | .mul e1 e2 => s!"(* {toSmtExpr step e1} {toSmtExpr step e2})"
  | .ite c th el => s!"(ite {toSmtExpr step c} {toSmtExpr step th} {toSmtExpr step el})"

/-- Declare all state variables at an unrolled time step. -/
def declareVarsAtStep (m : TSModule) (step : Nat) : List String :=
  m.variables.map fun v =>
    s!"(declare-const {varName v.name step} {toSmtSort v.sort})"

/-- Format variables to request values for in a counterexample trace up to depth `d`. -/
def getValueList (m : TSModule) (depth : Nat) : String :=
  let allVars := (List.range (depth + 1)).flatMap fun s =>
    m.variables.map fun v => varName v.name s
  s!"({" ".intercalate allVars})"

/--
Generate a complete Bounded Model Checking (BMC) SMT-LIB 2 script up to `maxDepth`.
Uses `(push 1)` and `(pop 1)` scopes at each step $0 \le d \le maxDepth$ to query
`(check-sat)` for invariant violations while incrementally advancing the state with `Next`.
-/
def bmcScript (m : TSModule) (invName : String) (maxDepth : Nat) : Except String String := do
  let invExpr ← match m.invariants.find? (·.1 == invName) with
    | some (_, expr) => pure expr
    | none => throw s!"invariant '{invName}' not found in module '{m.name}'"

  let mut lines : List String := [
    "; SMT-LIB 2 script generated by zil-lib (TS-03)",
    s!"; Module: {m.name}, Invariant: {invName}, MaxDepth: {maxDepth}",
    "(set-logic QF_LIA)",
    "(set-option :produce-models true)"
  ]

  -- Sort declarations
  for v in m.variables do
    if let some decl := declareSort v.sort then
      unless lines.contains decl do
        lines := lines.concat decl

  -- Declare unrolled variables for all steps up to maxDepth
  for s in [0:maxDepth + 1] do
    lines := lines ++ declareVarsAtStep m s

  -- Assert Init at step 0
  lines := lines.concat s!"(assert {toSmtExpr 0 m.init})"

  -- Iteratively check invariant at step d and step forward
  for d in [0:maxDepth + 1] do
    lines := lines.concat s!"(echo \"=== STEP {d} ===\")"
    lines := lines.concat "(push 1)"
    lines := lines.concat s!"(assert (not {toSmtExpr d invExpr}))"
    lines := lines.concat "(check-sat)"
    lines := lines.concat s!"(get-value {getValueList m d})"
    lines := lines.concat "(pop 1)"
    if d < maxDepth then
      lines := lines.concat s!"(assert {toSmtExpr d m.next})"

  lines := lines.concat "(exit)"
  pure ("\n".intercalate lines ++ "\n")

/--
Generate $k$-induction SMT-LIB 2 scripts for:
1. Base case: checks if any step $0 \le s \le k$ violates the invariant from `Init`.
2. Step case: checks if $k$ consecutive states satisfying the invariant can lead to a violation.
-/
def inductScript (m : TSModule) (invName : String) (k : Nat) : Except String (String × String) := do
  if k == 0 then
    throw "k-induction requires k >= 1"
  let invExpr ← match m.invariants.find? (·.1 == invName) with
    | some (_, expr) => pure expr
    | none => throw s!"invariant '{invName}' not found in module '{m.name}'"

  -- Base case script
  let mut baseLines : List String := [
    "; SMT-LIB 2 k-induction base case (TS-03)",
    s!"; Module: {m.name}, Invariant: {invName}, k: {k}",
    "(set-logic QF_LIA)",
    "(set-option :produce-models true)"
  ]
  for v in m.variables do
    if let some decl := declareSort v.sort then
      unless baseLines.contains decl do
        baseLines := baseLines.concat decl

  for s in [0:k + 1] do
    baseLines := baseLines ++ declareVarsAtStep m s

  baseLines := baseLines.concat s!"(assert {toSmtExpr 0 m.init})"
  for s in [0:k] do
    baseLines := baseLines.concat s!"(assert {toSmtExpr s m.next})"

  let baseViolations := (List.range (k + 1)).map fun s => s!"(not {toSmtExpr s invExpr})"
  let baseDisj := if baseViolations.length == 1 then baseViolations.head! else s!"(or {" ".intercalate baseViolations})"
  baseLines := baseLines.concat s!"(assert {baseDisj})"
  baseLines := baseLines.concat "(check-sat)"
  baseLines := baseLines.concat s!"(get-value {getValueList m k})"
  baseLines := baseLines.concat "(exit)"

  -- Step case script
  let mut stepLines : List String := [
    "; SMT-LIB 2 k-induction inductive step (TS-03)",
    s!"; Module: {m.name}, Invariant: {invName}, k: {k}",
    "(set-logic QF_LIA)",
    "(set-option :produce-models true)"
  ]
  for v in m.variables do
    if let some decl := declareSort v.sort then
      unless stepLines.contains decl do
        stepLines := stepLines.concat decl

  for s in [0:k + 1] do
    stepLines := stepLines ++ declareVarsAtStep m s

  -- Invariant holds for states 0 .. k-1
  for s in [0:k] do
    stepLines := stepLines.concat s!"(assert {toSmtExpr s invExpr})"
  -- Next transitions hold for 0 .. k-1
  for s in [0:k] do
    stepLines := stepLines.concat s!"(assert {toSmtExpr s m.next})"
  -- Invariant violated at state k
  stepLines := stepLines.concat s!"(assert (not {toSmtExpr k invExpr}))"
  stepLines := stepLines.concat "(check-sat)"
  stepLines := stepLines.concat s!"(get-value {getValueList m k})"
  stepLines := stepLines.concat "(exit)"

  pure ("\n".intercalate baseLines ++ "\n", "\n".intercalate stepLines ++ "\n")

end ZilLib.SMT
